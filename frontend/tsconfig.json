{
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],

  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",

    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "jsx": "react-jsx",

    "strict": false,
    "noEmit": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    "types": ["node", "vite/client"],

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "ignoreDeprecations": "6.0"
  }
}